# EASP - Enterprise AI Security Platform
# Environment Variables Example
# Copy this file to .env and fill in real development values.
# Never commit the real .env file.

# --- MongoDB ---
MONGO_USERNAME=easp_dev
MONGO_PASSWORD=change_me_dev_password
MONGO_URI=mongodb://easp_dev:change_me_dev_password@mongodb:27017/easp?authSource=admin

# --- Backend Configuration ---
PORT=5000
NODE_ENV=development
AI_SERVICE_URL=http://ai_service:8000

# --- Security & CORS Allow-List ---
# Comma-separated list of allowed web origins (protocols + hostnames + ports, no trailing slashes)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend ---
VITE_BACKEND_URL=http://localhost:5000
