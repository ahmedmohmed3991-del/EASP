# EASP - Enterprise AI Security Platform
# Environment Variables Example
# Copy this file to .env and fill in real development values.
# Never commit the real .env file.

# --- MongoDB ---
MONGO_USERNAME=easp_dev
MONGO_PASSWORD=change_me_dev_password
MONGO_URI=mongodb://easp_dev:change_me_dev_password@mongodb:27017/easp?authSource=admin

# --- Backend Configuration ---
PORT=5000
NODE_ENV=development
AI_SERVICE_URL=http://ai_service:8000
AI_SERVICE_TOKEN=
# Set a random internal-service token before running Docker Compose; use the same token in .NET.

# --- Security & CORS Allow-List ---
# Comma-separated list of allowed web origins (protocols + hostnames + ports, no trailing slashes)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Authentication & Encryption (Development defaults) ---
JWT_SECRET=easp_dev_jwt_access_secret_do_not_use_in_prod_1234567890
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=easp_dev_jwt_refresh_secret_do_not_use_in_prod_0987654321
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Frontend ---
VITE_BACKEND_URL=http://localhost:5000

